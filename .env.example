# Neon (Postgres)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Internal marketplace administration
# Comma-separated authenticated user emails allowed to access /dashboard/admin.
BRAIDEL_ADMIN_EMAILS=

# Stripe (Workstream 5, required before enabling payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Hostnames of PRODUCTION database(s), comma-separated, no credentials.
# db:seed and verify:booking refuse to run against these, and refuse to run at
# all if this is unset. Use a separate Neon branch for local development.
BRAIDEL_PRODUCTION_DB_HOSTS=
